# Copy to .env and change the secrets:  cp .env.example .env

# ---- Databases (each service owns its own Postgres container) ----
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_auth_db
AUTH_DB_NAME=auth_db

CLINIC_DB_USER=clinic_user
CLINIC_DB_PASSWORD=change_me_clinic_db
CLINIC_DB_NAME=clinic_db

# ---- Authentication service ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Set true ONLY when the site is served over HTTPS (the VM demo uses plain http)
COOKIE_SECURE=false

# Seed the 4 demo accounts on startup (admin / 2 dentists / patient)
SEED_DEMO_DATA=true

# Host port that the reverse proxy will publish
PROXY_PORT=8080

# ---- Docker Hub (used to name/push images) ----
DOCKERHUB_USER=ahmadhellani
IMAGE_TAG=v1